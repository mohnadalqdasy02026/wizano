/// S19 — تفاصيل أي عملية في كشف الحساب: القيم، النوع/المصدر، الحالة، والأثر على الرصيد.
///
/// يوفّر إجراءات المرحلة 11: تسجيل مرتجع، إلغاء عملية (للمشتريات النشطة)، وتصحيح مالي.
class OperationDetailsScreen extends StatefulWidget {
  const OperationDetailsScreen({
    super.key,
    required this.entry,
    this.shopId,
    this.customerId,
    this.customerName,
    this.onChanged,
  });

  final StatementEntry entry;
  final String? shopId;
  final String? customerId;
  final String? customerName;
  final VoidCallback? onChanged;

  @override
  State<OperationDetailsScreen> createState() => _OperationDetailsScreenState();
}

class _OperationDetailsScreenState extends State<OperationDetailsScreen> {
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('تفاصيل العملية')),
      body: _buildBody(context),
    );
  }

  Widget _buildBody(BuildContext context) {
    final entry = widget.entry;

    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Card(
            elevation: 2,
            child: Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    children: [
                      CircleAvatar(
                        backgroundColor: _getTypeColor(widget.entry.type),
                        child: Icon(_getTypeIcon(widget.entry.type), color: Colors.white, size: 24),
                      ),
                      const SizedBox(width: 12),
                      Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Text(
                              _getTypeLabel(widget.entry.type),
                              style: const TextStyle(
                                fontSize: 18,
                                fontWeight: FontWeight.bold,
                                color: Colors.black87,
                              ),
                            ),
                            const SizedBox(height: 4),
                            Text(
                              '#${widget.entry.shopSeq ?? widget.entry.id.substring(0, 8)}',
                              style: TextStyle(
                                fontSize: 14,
                                color: Colors.grey[600],
                              ),
                            ),
                          ],
                        ),
                      ),
                      const SizedBox(width: 12),
                      Container(
                        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                        decoration: BoxDecoration(
                          color: _getStatusColor(widget.entry.status),
                          borderRadius: BorderRadius.circular(20),
                        ),
                        child: Text(
                          _getStatusLabel(widget.entry.status),
                          style: const TextStyle(
                            color: Colors.white,
                            fontSize: 12,
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 12),
                  Row(
                    children: [
                      Expanded(
                        child: _buildInfoColumn(
                          label: 'التاريخ',
                          value: _formatDate(widget.entry.occurredAt),
                          icon: Icons.calendar_today,
                          color: Colors.blue,
                        ),
                      ),
                      Expanded(
                        child: _buildInfoColumn(
                          label: 'المبلغ',
                          value: '${widget.entry.effect >= 0 ? '+' : ''}${NumberFormat('#,###').format(widget.entry.effect.abs())}',
                          icon: widget.entry.effect >= 0 ? Icons.arrow_upward : Icons.arrow_downward,
                          color: widget.entry.effect >= 0 ? Colors.green : Colors.red,
                        ),
                      ),
                      Expanded(
                        child: _buildInfoColumn(
                          label: 'الرصيد بعد',
                          value: '${NumberFormat('#,###').format(widget.entry.balanceAfter)}',
                          icon: Icons.account_balance_wallet,
                          color: const Color(0xFF0B2A4A),
                        ),
                      ),
                    ],
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 24),

          if (widget.entry.description.isNotEmpty) ...[
            const Text(
              'التفاصيل',
              style: TextStyle(
                fontSize: 16,
                fontWeight: FontWeight.bold,
                color: Colors.black87,
              ),
            ),
            const SizedBox(height: 8),
            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                color: Colors.grey[100],
                borderRadius: BorderRadius.circular(8),
              ),
              child: Text(
                widget.entry.description,
                style: const TextStyle(fontSize: 14, height: 1.5),
              ),
            ),
            const SizedBox(height: 24),
          ],

          if (widget.entry.purchaseId != null) ...[
            const Text(
              'العملية المرتبطة',
              style: TextStyle(
                fontSize: 16,
                fontWeight: FontWeight.bold,
                color: Colors.black87,
              ),
            ),
            const SizedBox(height: 8),
            ListTile(
              leading: const Icon(Icons.link, color: Color(0xFF0B2A4A)),
              title: const Text('العملية المرتبطة'),
              subtitle: Text('#${widget.entry.purchaseId?.substring(0, 8) ?? ''}'),
              trailing: const Icon(Icons.chevron_left),
              onTap: () {
                // TODO: التنقل للعملية المرتبطة
              },
            ),
            const SizedBox(height: 24),
          ],

          _buildAdjustmentTypeSection(),

          const SizedBox(height: 32),
          _buildActionButtons(),
        ],
      ),
    );
  }

  Widget _buildAdjustmentTypeSection() {
    final entry = widget.entry;
    if (entry.type != 'adjustment') {
      return const SizedBox.shrink();
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          'نوع التصحيح',
          style: TextStyle(
            fontSize: 16,
            fontWeight: FontWeight.bold,
            color: Colors.black87,
          ),
        ),
        const SizedBox(height: 8),
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
          decoration: BoxDecoration(
            color: entry.adjustmentKind == 'cancellation'
                ? Colors.red[50]
                : Colors.blue[50],
            borderRadius: BorderRadius.circular(20),
          ),
          child: Text(
            entry.adjustmentKind == 'cancellation' ? 'إلغاء عملية' : 'تصحيح مالي',
            style: TextStyle(
              color: entry.adjustmentKind == 'cancellation' ? Colors.red[700] : Colors.blue[700],
              fontWeight: FontWeight.w600,
            ),
          ),
        const SizedBox(height: 24),
      ],
    );
  }

  Widget _buildActionButtons() {
    final entry = widget.entry;
    final isActivePurchase = entry.isPurchase && entry.status == 'active';

    if (isActivePurchase) {
      return _buildActivePurchaseButtons();
    } else if (entry.type == 'return') {
      return _buildReturnTypeButtons();
    } else if (entry.type == 'adjustment') {
      return _buildAdjustmentTypeButtons();
    } else {
      return const SizedBox.shrink();
    }
  }

  Widget _buildActivePurchaseButtons() {
    return Row(
      children: [
        Expanded(
          child: ElevatedButton.icon(
            onPressed: () {
              Future.microtask(() => _openCancel(context));
            },
            icon: const Icon(Icons.cancel_outlined),
            label: const Text('إلغاء العملية'),
            style: ElevatedButton.styleFrom(
              backgroundColor: Colors.red[600],
              foregroundColor: Colors.white,
              padding: const EdgeInsets.symmetric(vertical: 12),
            ),
          ),
        const SizedBox(width: 12),
        Expanded(
          child: ElevatedButton.icon(
            onPressed: () {
              Future.microtask(() => _openReturn(context));
            },
            icon: const Icon(Icons.assignment_return_outlined),
            label: const Text('تسجيل مرتجع'),
            style: ElevatedButton.styleFrom(
              backgroundColor: Colors.orange[600],
              foregroundColor: Colors.white,
              padding: const EdgeInsets.symmetric(vertical: 12),
            ),
          ),
        ],
      );
    }

    Widget _buildReturnTypeButtons() {
      return Row(
        children: [
          Expanded(
            child: OutlinedButton.icon(
              onPressed: () {
                // TODO: عرض تفاصيل المرتجع
              },
              icon: const Icon(Icons.visibility),
              label: const Text('عرض التفاصيل'),
              style: OutlinedButton.styleFrom(
                padding: const EdgeInsets.symmetric(vertical: 12),
              ),
            ),
          ),
        ],
      );
    }

    Widget _buildAdjustmentTypeButtons() {
      return Row(
        children: [
          Expanded(
            child: OutlinedButton.icon(
              onPressed: () {
                // TODO: عرض تفاصيل التصحيح
              },
              icon: const Icon(Icons.visibility),
              label: const Text('عرض التفاصيل'),
              style: OutlinedButton.styleFrom(
                padding: const EdgeInsets.symmetric(vertical: 12),
              ),
            ),
          ),
        ],
      );
    }

    Widget _buildAdjustmentTypeSection() {
      final entry = widget.entry;
      if (entry.type != 'adjustment') {
        return const SizedBox.shrink();
      }

      return Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text(
            'نوع التصحيح',
            style: TextStyle(
              fontSize: 16,
              fontWeight: FontWeight.bold,
              color: Colors.black87,
            ),
          ),
          const SizedBox(height: 8),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
            decoration: BoxDecoration(
              color: entry.adjustmentKind == 'cancellation'
                  ? Colors.red[50]
                  : Colors.blue[50],
              borderRadius: BorderRadius.circular(20),
            ),
            child: Text(
              entry.adjustmentKind == 'cancellation' ? 'إلغاء عملية' : 'تصحيح مالي',
              style: TextStyle(
                color: entry.adjustmentKind == 'cancellation' ? Colors.red[700] : Colors.blue[700],
                fontWeight: FontWeight.w600,
