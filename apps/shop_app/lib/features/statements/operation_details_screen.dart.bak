    Widget _buildInfoColumn({
      required String label,
      required String value,
      required IconData icon,
      required Color color,
    }) {
      return Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(icon, size: 16, color: color),
              const SizedBox(width: 4),
              Expanded(
                child: Text(
                  label,
                  style: const TextStyle(
                    fontSize: 12,
                    color: Colors.grey[600],
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 4),
          Text(
            value,
            style: TextStyle(
              fontSize: 14,
              fontWeight: FontWeight.w500,
              color: Colors.black87,
            ),
            overflow: TextOverflow.ellipsis,
          ),
        ],
      );
    }

    Future<void> _openCancel(BuildContext context) async {
      int purchaseVersion = 1;
      if (widget.entry.isPurchase) {
        try {
          final controller = context.read<PurchaseController>();
          final purchase = await controller.getPurchase(widget.entry.id);
          purchaseVersion = purchase?.version ?? 1;
        } catch (_) {}
      }

      final result = await Navigator.of(context).push(
        MaterialPageRoute(
          builder: (_) => CancelPurchaseScreen(
            purchaseId: widget.entry.id,
            purchaseLabel: widget.entry.shopSeq == null ? null : '#${widget.entry.shopSeq}',
            purchaseEffect: widget.entry.effect,
            purchaseVersion: purchaseVersion,
          ),
        ),
      );
      if (result != null) {
        widget.onChanged?.call();
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(content: Text('تم إلغاء العملية.')),
          );
        }
      }
    }

    Future<void> _openReturn(BuildContext context) async {
      final result = await Navigator.of(context).push(
        MaterialPageRoute(
          builder: (_) => ReturnFormScreen(
            purchaseId: widget.entry.id,
            purchaseLabel: widget.entry.shopSeq == null ? null : '#${widget.entry.shopSeq}',
            maxAmount: widget.entry.effect,
          ),
        ),
      );
      if (result != null) {
        widget.onChanged?.call();
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(content: Text('تم تسجيل المرتجع.')),
          );
        }
      }
    }

    Future<void> _openAdjustment(BuildContext context) async {
      final result = await Navigator.of(context).push(
        MaterialPageRoute(
          builder: (_) => AdjustmentFormScreen(
            customerId: widget.customerId!,
            customerName: widget.customerName ?? '',
            relatedPurchaseId: widget.entry.isPurchase ? widget.entry.id : null,
          ),
        ),
      );
      if (result != null) {
        widget.onChanged?.call();
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(content: Text('تم تسجيل التصحيح.')),
          );
        }
      }
    }

    Color _getTypeColor(String type) {
      switch (type) {
        case 'purchase':
          return Colors.blue[800]!;
        case 'payment':
          return Colors.teal;
        case 'return':
          return Colors.orange;
        case 'adjustment':
          return Colors.blue;
        default:
          return Colors.grey;
      }
    }

    IconData _getTypeIcon(String type) {
      switch (type) {
        case 'purchase':
          return Icons.shopping_bag_outlined;
        case 'payment':
          return Icons.payments_outlined;
        case 'return':
          return Icons.assignment_return_outlined;
        case 'adjustment':
          return Icons.tune;
        default:
          return Icons.help_outline;
      }
    }

    String _getTypeLabel(String type) {
      switch (type) {
        case 'purchase':
          return 'شراء';
        case 'payment':
          return 'دفعة';
        case 'return':
          return 'مرتجع';
        case 'adjustment':
          return 'تصحيح';
        default:
          return type;
      }
    }

    String _getStatusLabel(String status) {
      switch (status) {
        case 'active':
          return 'نشط';
        case 'cancelled':
          return 'ملغى';
        case 'completed':
          return 'مكتمل';
        case 'pending':
          return 'معلق';
        default:
          return status;
      }
    }

    Color _getStatusColor(String status) {
      switch (status) {
        case 'active':
          return Colors.green;
        case 'cancelled':
          return Colors.red;
        case 'completed':
          return Colors.blue;
        case 'pending':
          return Colors.orange;
        default:
          return Colors.grey;
      }
    }

    String _formatDate(String iso) {
      try {
        return DateFormat('yyyy/MM/dd HH:mm').format(DateTime.parse(iso).toLocal());
      } catch (_) {
        return iso;
      }
    }

    Widget _buildInfoColumn({
      required String label,
      required String value,
      required IconData icon,
      required Color color,
    }) {
      return Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(icon, size: 16, color: color),
              const SizedBox(width: 4),
              Expanded(
                child: Text(
                  label,
                  style: const TextStyle(
                    fontSize: 12,
                    color: Colors.grey[600],
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 4),
          Text(
            value,
            style: TextStyle(
              fontSize: 14,
              fontWeight: FontWeight.w500,
              color: Colors.black87,
            ),
            overflow: TextOverflow.ellipsis,
          ),
        ],
      );
    }
  }
