# نسخة إعدادات البيئة — انسخها إلى .env وعِّد القيم.
# ملف .env الحقيقي لا يُرفع إلى المستودع أبدًا.

NODE_ENV=development
LOG_LEVEL=info

# الخادم
API_HOST=0.0.0.0
API_PORT=4000
# أصول CORS المسموح بها (مفصولة بفواصل). يبقى CORS مغلقًا إن تُرك فارغًا.
CORS_ORIGINS=
# فعّله فقط خلف reverse proxy موثوق يزيل ترويسات X-Forwarded القادمة من الإنترنت.
TRUST_PROXY=false

# قاعدة البيانات (دور التطبيق — لا يُستخدم مستخدم superuser هنا)
DATABASE_URL=postgresql://wizano_app:CHANGE_ME_APP_PASSWORD@localhost:5432/wizano_dev
DATABASE_URL_TEST=postgresql://wizano_app:CHANGE_ME_APP_PASSWORD@localhost:5432/wizano_test

# حدود الطلبات
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW=60000

# ----------------------------------------------------------------------------
# المصادقة (المرحلة 4)
# JWT_ACCESS_SECRET: سر عشوائي بطول 32 حرفًا على الأقل (مثال: openssl rand -hex 32)
# في الإنتاج يجب أن يكون سرًا فريدًا طويلًا وقويًا وغير مشترك.
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW=60000
